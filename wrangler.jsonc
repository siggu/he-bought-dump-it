{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "he-bought-dump-it",
  "main": "worker/index.ts",
  // 2024-09-02 이후 날짜여야 fetch()에서 KIS의 비표준 포트(:9443, :21000)를 쓸 수 있다(allow_custom_ports).
  "compatibility_date": "2025-09-01",
  "observability": { "enabled": true },

  // 프론트엔드(Vite 빌드 결과). /api/* 는 Worker가 먼저 처리하고 나머지는 SPA로 응답한다.
  "assets": {
    "directory": "./web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "he-bought-dump-it",
      // GitHub Actions 배포 시 자동으로 생성/채워진다. 직접 배포하려면 `npx wrangler d1 create he-bought-dump-it`의 ID로 바꿔 주세요.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  "durable_objects": {
    "bindings": [
      { "name": "PRICE_HUB", "class_name": "PriceHub" },
      // 비밀번호 해시 계산용 (무료 플랜 Worker CPU 한도 10ms 회피)
      { "name": "PASSWORD_HASHER", "class_name": "PasswordHasher" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PriceHub", "PasswordHasher"] }],

  "vars": {
    // auto: KIS_APP_KEY/KIS_APP_SECRET 시크릿이 있으면 실제 시세, 없으면 모의 시세
    "PRICE_FEED": "auto",
    // real: 실전투자 앱키 / demo: 모의투자 앱키
    "KIS_ENV": "real",
    // KRX 휴장일(주말 제외). 매년 갱신해 주세요.
    "MARKET_HOLIDAYS": "2026-01-01,2026-02-16,2026-02-17,2026-02-18,2026-03-02,2026-05-01,2026-05-05,2026-05-25,2026-06-03,2026-08-17,2026-09-24,2026-09-25,2026-10-05,2026-10-09,2026-12-25,2026-12-31,2027-01-01"
  }
}
